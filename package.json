{
  "name": "ebalangay",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @ebalangay/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @ebalangay/api exec prisma db seed",
    "db:test:reset": "pnpm --filter @ebalangay/api run db:test:reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ebalangay/config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.12",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0"
  }
}
