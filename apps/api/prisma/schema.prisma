// Phase 0: datasource + extensions only. Business tables arrive in later phases.
// Money columns: BigInt (centavos). Timestamps: @db.Timestamptz(3), stored UTC.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_trgm]
}
