model Order {
  id                               String                                 @id @default(uuid(7)) @db.Uuid
  /// Human code, e.g. EB-7K2Q9.
  code                             String                                 @unique
  /// Bumped on every change; socket events carry it.
  version                          Int                                    @default(0)
  type                             OrderType                              @default(regular)
  status                           OrderStatus                            @default(pending_payment)
  prepUpdate                       PrepUpdate?                            @map("prep_update")
  merchantId                       String                                 @map("merchant_id") @db.Uuid
  customerId                       String?                                @map("customer_id") @db.Uuid
  riderId                          String?                                @map("rider_id") @db.Uuid
  groupCartId                      String?                                @map("group_cart_id") @db.Uuid
  teamAccountId                    String?                                @map("team_account_id") @db.Uuid
  subscriptionOrderId              String?                                @map("subscription_order_id") @db.Uuid
  /// AddressSnapshot from @ebalangay/shared; null for POS.
  addressSnapshot                  Json?                                  @map("address_snapshot")
  dropoffLat                       Float?                                 @map("dropoff_lat")
  dropoffLng                       Float?                                 @map("dropoff_lng")
  dropoffLocation                  Unsupported("geography(Point, 4326)")? @map("dropoff_location")
  riderNotes                       String?                                @map("rider_notes")
  contactless                      Boolean                                @default(false)
  giftMessage                      String?                                @map("gift_message")
  recipientName                    String?                                @map("recipient_name")
  recipientPhone                   String?                                @map("recipient_phone")
  /// Gift orders: hide prices from the recipient (receipt, rider app).
  giftHidePrices                   Boolean                                @default(false) @map("gift_hide_prices")
  scheduledFor                     DateTime?                              @map("scheduled_for") @db.Timestamptz(3)
  /// Scheduled orders: when the release worker told the merchant to start preparing.
  releasedAt                       DateTime?                              @map("released_at") @db.Timestamptz(3)
  notes                            String?
  subtotalCentavos                 BigInt                                 @map("subtotal_centavos")
  deliveryFeeCentavos              BigInt                                 @default(0) @map("delivery_fee_centavos")
  serviceFeeCentavos               BigInt                                 @default(0) @map("service_fee_centavos")
  smallOrderFeeCentavos            BigInt                                 @default(0) @map("small_order_fee_centavos")
  /// All discounts (item + delivery), as in PriceBreakdown.
  discountCentavos                 BigInt                                 @default(0) @map("discount_centavos")
  /// Free-delivery part of discountCentavos.
  deliveryDiscountCentavos         BigInt                                 @default(0) @map("delivery_discount_centavos")
  tipCentavos                      BigInt                                 @default(0) @map("tip_centavos")
  donationCentavos                 BigInt                                 @default(0) @map("donation_centavos")
  pointsValueCentavos              BigInt                                 @default(0) @map("points_value_centavos")
  walletAppliedCentavos            BigInt                                 @default(0) @map("wallet_applied_centavos")
  totalCentavos                    BigInt                                 @map("total_centavos")
  commissionCentavos               BigInt                                 @default(0) @map("commission_centavos")
  merchantNetCentavos              BigInt                                 @default(0) @map("merchant_net_centavos")
  riderEarningCentavos             BigInt                                 @default(0) @map("rider_earning_centavos")
  /// Cancellation Protection credit to the merchant.
  cancellationCompensationCentavos BigInt                                 @default(0) @map("cancellation_compensation_centavos")
  /// Client-supplied key; same key + customer returns the same order.
  idempotencyKey                   String?                                @map("idempotency_key")
  /// sha256 of the normalized request; a reused key with a different body is rejected.
  idempotencyHash                  String?                                @map("idempotency_hash")
  prepTimeMinutes                  Int?                                   @map("prep_time_minutes")
  surgeBps                         Int                                    @default(10000) @map("surge_bps")
  paymentMethod                    PaymentMethod                          @map("payment_method")
  paymentStatus                    PaymentStatus                          @default(pending) @map("payment_status")
  voucherId                        String?                                @map("voucher_id") @db.Uuid
  pointsRedeemed                   Int                                    @default(0) @map("points_redeemed")
  etaAt                            DateTime?                              @map("eta_at") @db.Timestamptz(3)
  placedAt                         DateTime?                              @map("placed_at") @db.Timestamptz(3)
  confirmedAt                      DateTime?                              @map("confirmed_at") @db.Timestamptz(3)
  preparingAt                      DateTime?                              @map("preparing_at") @db.Timestamptz(3)
  readyAt                          DateTime?                              @map("ready_at") @db.Timestamptz(3)
  pickedUpAt                       DateTime?                              @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt                      DateTime?                              @map("delivered_at") @db.Timestamptz(3)
  cancelledAt                      DateTime?                              @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy                      OrderActor?                            @map("cancelled_by")
  cancelReason                     String?                                @map("cancel_reason")
  createdAt                        DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                        DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant           Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  customer           User?                @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  rider              Rider?               @relation(fields: [riderId], references: [id], onDelete: SetNull)
  groupCart          GroupCart?           @relation(fields: [groupCartId], references: [id], onDelete: SetNull)
  teamAccount        TeamAccount?         @relation(fields: [teamAccountId], references: [id], onDelete: SetNull)
  subscriptionOrder  SubscriptionOrder?   @relation(fields: [subscriptionOrderId], references: [id], onDelete: SetNull)
  voucher            Voucher?             @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  prepUpdates        OrderPrepUpdate[]
  chatMessages       OrderChatMessage[]
  replacements       OrderReplacement[]
  inventoryMoves     InventoryMovement[]
  payments           Payment[]
  refunds            Refund[]
  walletTransactions WalletTransaction[]
  pointsTransactions PointsTransaction[]
  voucherRedemption  VoucherRedemption?
  deliveryLegs       DeliveryLeg[]
  codCollection      CodCollection?
  riderIncidents     RiderIncident[]
  reviews            Review[]
  tickets            Ticket[]
  settlementItems    SettlementItem[]
  donations          Donation[]

  @@unique([customerId, idempotencyKey])
  @@index([merchantId, status, createdAt])
  @@index([merchantId, placedAt])
  @@index([customerId, createdAt])
  @@index([riderId, status])
  @@index([status, createdAt])
  @@index([groupCartId])
  @@index([teamAccountId])
  @@index([subscriptionOrderId])
  @@index([voucherId])
  @@index([scheduledFor])
  @@index([releasedAt, scheduledFor])
  @@index([dropoffLocation], type: Gist)
  @@map("orders")
}

/// Point-in-time snapshot: later product edits never change past orders.
model OrderItem {
  id                String             @id @default(uuid(7)) @db.Uuid
  orderId           String             @map("order_id") @db.Uuid
  productId         String?            @map("product_id") @db.Uuid
  variantId         String?            @map("variant_id") @db.Uuid
  name              String
  variantName       String?            @map("variant_name")
  quantity          Int
  unitPriceCentavos BigInt             @map("unit_price_centavos")
  /// [{ name, priceDeltaCentavos }]
  modifiers         Json               @default("[]")
  lineTotalCentavos BigInt             @map("line_total_centavos")
  notes             String?
  /// Set when the customer rejects a replacement for an out-of-stock item; excluded from totals.
  removedAt         DateTime?          @map("removed_at") @db.Timestamptz(3)
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant           Variant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)
  replacements      OrderReplacement[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid(7)) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actor       OrderActor
  actorUserId String?      @map("actor_user_id") @db.Uuid
  reason      String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([actorUserId])
  @@map("order_status_history")
}

model OrderPrepUpdate {
  id          String     @id @default(uuid(7)) @db.Uuid
  orderId     String     @map("order_id") @db.Uuid
  prepUpdate  PrepUpdate @map("prep_update")
  etaMinutes  Int?       @map("eta_minutes")
  actorUserId String?    @map("actor_user_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_prep_updates")
}

model OrderChatMessage {
  id         String    @id @default(uuid(7)) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  senderId   String    @map("sender_id") @db.Uuid
  senderRole UserRole  @map("sender_role")
  /// Conversation: merchant (customer<->store) | rider (customer<->rider).
  channel    String    @default("merchant")
  body       String
  imageUrl   String?   @map("image_url")
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender     User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, channel, createdAt])
  @@index([senderId])
  @@map("order_chat_messages")
}

/// Merchant proposes a substitute for an out-of-stock item; customer accepts or rejects.
model OrderReplacement {
  id                       String    @id @default(uuid(7)) @db.Uuid
  orderId                  String    @map("order_id") @db.Uuid
  orderItemId              String    @map("order_item_id") @db.Uuid
  replacementProductId     String?   @map("replacement_product_id") @db.Uuid
  replacementName          String    @map("replacement_name")
  replacementPriceCentavos BigInt    @map("replacement_price_centavos")
  quantity                 Int
  /// proposed | accepted | rejected | expired
  status                   String    @default("proposed")
  proposedById             String?   @map("proposed_by_id") @db.Uuid
  respondedAt              DateTime? @map("responded_at") @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  order                    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem                OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
  @@map("order_replacements")
}
