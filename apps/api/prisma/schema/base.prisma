// eBalangay schema. Conventions:
// - Tables/columns snake_case via @@map/@map; ids uuid v7; timestamps timestamptz(3), stored UTC.
// - Money: BigInt centavos (*_centavos). Rates: Int basis points (*_bps).
// - Geography columns are trigger-maintained from lat/lng or GeoJSON (see the postgis_rls
//   migration), so Prisma never writes PostGIS types directly.
// - Merchant-scoped tables have RLS keyed by app.current_merchant_id (see db.ts).
// - actor/reviewer/creator ids are plain indexed uuids (no FK) so audit history survives deletes.

generator client {
  provider        = "prisma-client"
  output          = "../../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Extensions live in their own schema so Prisma resets (shadow DB, migrate reset) never drop
  // them; ebalangay_app cannot recreate PostGIS. search_path must include "extensions".
  extensions = [postgis(schema: "extensions"), pg_trgm(schema: "extensions")]
}

