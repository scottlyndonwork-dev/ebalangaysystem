model Settlement {
  id                    String           @id @default(uuid(7)) @db.Uuid
  payeeType             PayeeType        @map("payee_type")
  merchantId            String?          @map("merchant_id") @db.Uuid
  riderId               String?          @map("rider_id") @db.Uuid
  /// Manila calendar days, inclusive.
  periodStart           DateTime         @map("period_start") @db.Date
  periodEnd             DateTime         @map("period_end") @db.Date
  orderCount            Int              @default(0) @map("order_count")
  grossCentavos         BigInt           @default(0) @map("gross_centavos")
  commissionCentavos    BigInt           @default(0) @map("commission_centavos")
  feesCentavos          BigInt           @default(0) @map("fees_centavos")
  cashCollectedCentavos BigInt           @default(0) @map("cash_collected_centavos")
  adjustmentsCentavos   BigInt           @default(0) @map("adjustments_centavos")
  netPayableCentavos    BigInt           @default(0) @map("net_payable_centavos")
  status                SettlementStatus @default(open)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant              Merchant?        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  rider                 Rider?           @relation(fields: [riderId], references: [id], onDelete: Restrict)
  items                 SettlementItem[]
  payouts               Payout[]

  @@index([merchantId, periodStart])
  @@index([riderId, periodStart])
  @@index([status])
  @@map("settlements")
}

model SettlementItem {
  id             String     @id @default(uuid(7)) @db.Uuid
  settlementId   String     @map("settlement_id") @db.Uuid
  orderId        String?    @map("order_id") @db.Uuid
  /// order | refund | adjustment | cod | commission | fee
  type           String
  amountCentavos BigInt     @map("amount_centavos")
  description    String
  settlement     Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  order          Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([settlementId])
  @@index([orderId])
  @@map("settlement_items")
}

model Payout {
  id                 String              @id @default(uuid(7)) @db.Uuid
  payeeType          PayeeType           @map("payee_type")
  merchantId         String?             @map("merchant_id") @db.Uuid
  riderId            String?             @map("rider_id") @db.Uuid
  settlementId       String?             @map("settlement_id") @db.Uuid
  amountCentavos     BigInt              @map("amount_centavos")
  status             PayoutStatus        @default(pending)
  /// gcash | maya | bank
  method             String
  destinationLabel   String              @map("destination_label")
  providerRef        String?             @unique @map("provider_ref")
  idempotencyKey     String              @unique @map("idempotency_key")
  failureReason      String?             @map("failure_reason")
  requestedAt        DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  paidAt             DateTime?           @map("paid_at") @db.Timestamptz(3)
  merchant           Merchant?           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  rider              Rider?              @relation(fields: [riderId], references: [id], onDelete: Restrict)
  settlement         Settlement?         @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  walletTransactions WalletTransaction[]

  @@index([merchantId, requestedAt])
  @@index([riderId, requestedAt])
  @@index([settlementId])
  @@index([status])
  @@map("payouts")
}

/// Merchant SaaS plans and customer memberships.
model Subscription {
  id                 String    @id @default(uuid(7)) @db.Uuid
  merchantId         String?   @map("merchant_id") @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  plan               String
  /// trialing | active | past_due | cancelled
  status             String    @default("active")
  priceCentavos      BigInt    @map("price_centavos")
  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz(3)
  cancelAt           DateTime? @map("cancel_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant           Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices           Invoice[]

  @@index([merchantId])
  @@index([userId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  number         String        @unique
  subscriptionId String?       @map("subscription_id") @db.Uuid
  merchantId     String?       @map("merchant_id") @db.Uuid
  amountCentavos BigInt        @map("amount_centavos")
  /// draft | open | paid | void
  status         String        @default("open")
  dueAt          DateTime      @map("due_at") @db.Timestamptz(3)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(3)
  pdfFileKey     String?       @map("pdf_file_key")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  merchant       Merchant?     @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
  @@index([merchantId, createdAt])
  @@index([status, dueAt])
  @@map("invoices")
}

model AdCampaign {
  id             String         @id @default(uuid(7)) @db.Uuid
  merchantId     String         @map("merchant_id") @db.Uuid
  name           String
  /// home_banner | search_top | category_top | store_list
  placement      String
  budgetCentavos BigInt         @map("budget_centavos")
  spentCentavos  BigInt         @default(0) @map("spent_centavos")
  bidCentavos    BigInt         @map("bid_centavos")
  /// draft | active | paused | ended
  status         String         @default("draft")
  startsAt       DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime       @map("ends_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant       Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  impressions    AdImpression[]

  @@index([merchantId])
  @@index([status, placement, startsAt])
  @@map("ad_campaigns")
}

model AdImpression {
  id         String     @id @default(uuid(7)) @db.Uuid
  campaignId String     @map("campaign_id") @db.Uuid
  userId     String?    @map("user_id") @db.Uuid
  /// impression | click | conversion
  kind       String
  occurredAt DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(3)
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, occurredAt])
  @@index([userId])
  @@map("ad_impressions")
}

model FlashSaleEvent {
  id        String              @id @default(uuid(7)) @db.Uuid
  name      String
  startsAt  DateTime            @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime            @map("ends_at") @db.Timestamptz(3)
  /// scheduled | live | ended
  status    String              @default("scheduled")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  merchants FlashSaleMerchant[]

  @@index([status, startsAt])
  @@map("flash_sale_events")
}

model FlashSaleMerchant {
  eventId     String         @map("event_id") @db.Uuid
  merchantId  String         @map("merchant_id") @db.Uuid
  productIds  String[]       @map("product_ids") @db.Uuid
  discountBps Int            @map("discount_bps")
  event       FlashSaleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  merchant    Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([eventId, merchantId])
  @@index([merchantId])
  @@map("flash_sale_merchants")
}

/// "Teams": companies paying for employees' orders.
model TeamAccount {
  id              String          @id @default(uuid(7)) @db.Uuid
  name            String
  ownerUserId     String          @map("owner_user_id") @db.Uuid
  billingWalletId String?         @map("billing_wallet_id") @db.Uuid
  /// active | suspended
  status          String          @default("active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  owner           User            @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  billingWallet   Wallet?         @relation(fields: [billingWalletId], references: [id], onDelete: SetNull)
  members         TeamMember[]
  allowances      TeamAllowance[]
  orders          Order[]

  @@index([ownerUserId])
  @@index([billingWalletId])
  @@map("team_accounts")
}

model TeamMember {
  id         String          @id @default(uuid(7)) @db.Uuid
  teamId     String          @map("team_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  /// admin | member
  role       String          @default("member")
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  team       TeamAccount     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowances TeamAllowance[]

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamAllowance {
  id             String      @id @default(uuid(7)) @db.Uuid
  teamId         String      @map("team_id") @db.Uuid
  /// Null = applies to every member.
  memberId       String?     @map("member_id") @db.Uuid
  /// daily | weekly | monthly
  period         String
  amountCentavos BigInt      @map("amount_centavos")
  usedCentavos   BigInt      @default(0) @map("used_centavos")
  resetsAt       DateTime    @map("resets_at") @db.Timestamptz(3)
  team           TeamAccount @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member         TeamMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([memberId])
  @@map("team_allowances")
}

/// Recurring orders (e.g. weekly groceries).
model SubscriptionOrder {
  id            String        @id @default(uuid(7)) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  merchantId    String        @map("merchant_id") @db.Uuid
  addressId     String        @map("address_id") @db.Uuid
  /// CartItemSelection[] from @ebalangay/shared.
  items         Json
  paymentMethod PaymentMethod @map("payment_method")
  /// daily | weekly | biweekly | monthly
  cadence       String
  nextRunAt     DateTime      @map("next_run_at") @db.Timestamptz(3)
  /// active | paused | cancelled
  status        String        @default("active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant      Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  address       Address       @relation(fields: [addressId], references: [id], onDelete: Restrict)
  orders        Order[]

  @@index([userId])
  @@index([merchantId])
  @@index([addressId])
  @@index([status, nextRunAt])
  @@map("subscription_orders")
}
