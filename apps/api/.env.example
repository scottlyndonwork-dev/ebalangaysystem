# Copy to .env (dev) and .env.test (tests). Never commit real values.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Local Postgres 17 runs on port 5433. App connects as non-superuser ebalangay_app.
DATABASE_URL=postgresql://ebalangay_app:CHANGE_ME@localhost:5433/ebalangay_dev
TEST_DATABASE_URL=postgresql://ebalangay_app:CHANGE_ME@localhost:5433/ebalangay_test

# Local Redis is Memurai on 6379. Tests use logical DB 1 so they never touch dev data.
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Mobile apps below this version receive 426 UPGRADE_REQUIRED.
MIN_APP_VERSION=0.0.0

# Optional in dev.
SENTRY_DSN=
