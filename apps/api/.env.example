# Copy to .env (dev) and .env.test (tests). Never commit real values.
# Generate the secrets below into your .env / .env.test with:  node scripts/gen-secrets.mjs
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Local Postgres 17 on port 5433 (PostGIS + pg_trgm). App connects as non-superuser ebalangay_app.
DATABASE_URL=postgresql://ebalangay_app:CHANGE_ME@localhost:5433/ebalangay_dev
TEST_DATABASE_URL=postgresql://ebalangay_app:CHANGE_ME@localhost:5433/ebalangay_test
# Pre-created by a superuser with PostGIS + pg_trgm (ebalangay_app cannot create databases).
SHADOW_DATABASE_URL=postgresql://ebalangay_app:CHANGE_ME@localhost:5433/ebalangay_shadow

# Local Redis is Memurai on 6379. Tests use logical DB 1 so they never touch dev data.
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1
# Worker process (pnpm --filter @ebalangay/api worker:dev). Redis needs maxmemory-policy noeviction.
OUTBOX_POLL_MS=500

# Mobile apps below this version receive 426 UPGRADE_REQUIRED.
MIN_APP_VERSION=0.0.0

# Comma-separated browser origins (merchant-web, admin-web).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Reverse proxies in front of the API (Railway = 1). Only this many X-Forwarded-For hops are
# trusted, so clients can't fake their IP to dodge OTP/login rate limits. 0 = direct exposure.
TRUST_PROXY_HOPS=1
# Swagger UI at /docs; defaults to on outside production.
# DOCS_ENABLED=true

# Auth secrets: at least 32 chars each. DATA_ENCRYPTION_KEY is base64 of 32 random bytes.
JWT_ACCESS_SECRET=
OTP_PEPPER=
COOKIE_SECRET=
DATA_ENCRYPTION_KEY=
# COOKIE_DOMAIN=.ebalangay.ph
# Comma-separated IPs/CIDRs for /v1/admin. Required in production; empty allows all in dev.
ADMIN_IP_ALLOWLIST=

# SMS: console prints OTPs to the API log (dev/test). Production must use semaphore.
SMS_DRIVER=console
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=EBALANGAY

# Push: console (dev, prints) | expo (required in production)
PUSH_DRIVER=console
EXPO_ACCESS_TOKEN=

# Optional in dev.
SENTRY_DSN=
# Seed admin password (dev only). Defaults to ChangeMe-Dev-2026!
# SEED_ADMIN_PASSWORD=
