{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", "packages/config/**"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.{ts,tsx}", "!README.md"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^build", "db:generate"], "outputs": [] },
    "lint": { "outputs": [] },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": [],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL", "REDIS_URL", "TEST_REDIS_URL"]
    }
  }
}
