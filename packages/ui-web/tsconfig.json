{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Consumed only through Next.js, so resolve like a bundler.
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src"]
}
