{
  "name": "@ebalangay/ui-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "default": "./dist/tailwind-preset.js"
    }
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --reporter=dot"
  },
  "dependencies": {
    "@ebalangay/shared": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.74.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.5"
  }
}
